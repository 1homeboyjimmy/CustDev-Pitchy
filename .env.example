# =============================================================
# Pitchy CustDev Configuration
# =============================================================
# AI calls use Polza, as in the main Pitchy project.
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== Polza Configuration (same names as the main Pitchy project) =====
POLZA_API_KEY=
POLZA_API_BASE=https://polza.ai/api/v1
POLZA_MODEL=openai/gpt-6-luna-pro
POLZA_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Approved per-task models. LLM_*, OPENAI_* and BOOST aliases are derived
# automatically; stale values cannot send workers to another provider.
CUSTDEV_MODEL_SEARCH=deepseek/deepseek-v4-flash
CUSTDEV_MODEL_SIGNALS=openai/gpt-6-luna-pro
CUSTDEV_MODEL_ONTOLOGY=openai/gpt-6-luna-pro
CUSTDEV_MODEL_EXTRACTION=deepseek/deepseek-v4-flash
CUSTDEV_MODEL_PROFILES=openai/gpt-6-luna
CUSTDEV_MODEL_SIMULATION_CONFIG=deepseek/deepseek-v4-flash
CUSTDEV_MODEL_SIMULATION=openai/gpt-6-luna
CUSTDEV_MODEL_GRAPH_ANALYSIS=openai/gpt-6-luna-pro
CUSTDEV_MODEL_REPORT=openai/gpt-6-luna-pro
CUSTDEV_MODEL_VERDICT=openai/gpt-6-luna-pro
CUSTDEV_MODEL_REPORT_CHAT=openai/gpt-6-luna

# ===== Neo4j Configuration =====
# For Docker: use service name "neo4j" instead of "localhost"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Docker-mode overrides =====
# Uncomment when running Neo4j inside Docker.
# NEO4J_URI=bolt://neo4j:7687

# ===== Production Frontend Configuration =====
# For production (over HTTPS), leave empty to use relative paths 
# This prevents Mixed Content errors.
VITE_API_BASE_URL=

# ===== CustDev SSO =====
# The main Pitchy JWT signing secret is not used by the new SSO bridge.
CUSTDEV_SSO_MODE=dual
CUSTDEV_SSO_CLIENT_ID=custdev
CUSTDEV_SSO_AUTHORIZE_URL=https://pitchy.pro/auth/sso/custdev/authorize
CUSTDEV_SSO_EXCHANGE_URL=https://pitchy.pro/internal/auth/custdev/exchange
CUSTDEV_SSO_INTROSPECT_URL=https://pitchy.pro/internal/auth/custdev/introspect
CUSTDEV_SSO_REVOKE_URL=https://pitchy.pro/internal/auth/custdev/revoke
CUSTDEV_SSO_REDIRECT_URI=https://custdev.pitchy.pro/api/auth/callback
CUSTDEV_SSO_SERVICE_SECRET=
CUSTDEV_SSO_TIMEOUT=5
CUSTDEV_SSO_RECHECK_SECONDS=60
CUSTDEV_SESSION_SECRET=
# Market research: same German HTTP CONNECT proxy as main Pitchy.
# Set SEARCH_HTTPS_PROXY or EXA_HTTPS_PROXY on the server; never commit credentials.
SEARCH_HTTPS_PROXY=
EXA_HTTPS_PROXY=
SIGNAL_HTTPS_PROXY=
SIGNAL_RESEARCH_SECONDS=170
SIGNAL_CRAWL_SECONDS=75
SIGNAL_MAX_PAGES=48
SIGNAL_MAX_COMMENTS=20
SIGNAL_BROWSER_ENABLED=1
